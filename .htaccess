# Coastal Cruise - Apache static hosting rules.
# Safe to leave in place for file:// use; Apache ignores it elsewhere.

Options -Indexes
DirectoryIndex index.html

# Correct MIME types for vendored JS, baked data and audio.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType audio/mp4 .m4a
  AddType audio/ogg .ogg
  AddType audio/wav .wav
  AddType model/gltf-binary .glb
</IfModule>

# Compress only text assets. Audio and images are already compressed and must
# keep stable byte offsets for HTTP Range requests.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css \
    application/javascript application/json application/xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
    application/javascript application/json application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType audio/mp4 "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Generic assets first, then the generated/pages exception below. Later
  # FilesMatch blocks override earlier ones, so the no-store rule must be last.
  <FilesMatch "\.(js|css|json|m4a|mp3|ogg|wav|png|jpe?g|glb)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "^(index\.html|map-editor\.html|style\.css|MapEdits\.js|CommunityAssets\.js|MapEditor\.js|CrimeSystem\.js|npcs\.js|game\.js)$">
    Header set Cache-Control "no-store, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Apache core already supports byte ranges for static files. Do not add a
# Header rule that removes Accept-Ranges or forces 200 responses for audio.
